{
  "name": "@alyt/svelte",
  "version": "0.1.0",
  "description": "Svelte 5 bindings for alyt — AnalyticsProvider and analytics context",
  "keywords": [
    "analytics",
    "svelte",
    "sveltekit",
    "typescript",
    "event-tracking"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mathematic-inc/alyt.git",
    "directory": "packages/svelte"
  },
  "license": "Apache-2.0",
  "author": "Mathematic Inc",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "svelte": "./build/index.js",
      "default": "./build/index.js"
    }
  },
  "svelte": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build",
    "!build/**/*.test*"
  ],
  "scripts": {
    "build": "svelte-package -i src -o build",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@alyt/core": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "jsdom": "^30.0.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
